{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "update": {
      "dependsOn": ["build"],
      "outputs": ["**/*.tgz"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false
    },
    "eslint": {
      "outputs": []
    },
    "tsc": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "playwright": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"]
    },
    "playwright:update": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
