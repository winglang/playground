{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "update": {
      "dependsOn": ["^update"]
    },
    "dev": {
      "dependsOn": ["build", "^dev"],
      "cache": false
    },
    "tsc": {}
  }
}
